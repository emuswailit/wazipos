{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "paths": {
      "@/*": ["*"],
      "@/hooks/*": ["hooks/*"],
      "@/components/*": ["components/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "app/(wholesalers)/wholesaleOrders/InvoiceLineItemsTable.jsx",
    "app/(wholesalers)/wholesaleOrders/index.jsx"
  ]
}
