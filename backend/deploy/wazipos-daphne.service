# deploy/wazipos-daphne.service — the WebSocket (ASGI) server for wss://api.wazipos.co.ke/ws/...
#
# Install (adjust User / paths if yours differ):
#   sudo cp deploy/wazipos-daphne.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now wazipos-daphne
#   sudo systemctl status wazipos-daphne        # should be "active (running)"
#   journalctl -u wazipos-daphne -f             # live log (wazi.ws lines: socket open / refuse / close)
#
# After every deploy: sudo systemctl restart wazipos-daphne
# nginx must send /ws/ to 127.0.0.1:8001 (deploy/nginx-websockets.conf).

[Unit]
Description=WaziPOS WebSockets (Daphne, Django Channels)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=mike
Group=www-data
WorkingDirectory=/var/www/wazipos/backend
Environment=DJANGO_SETTINGS_MODULE=wazi.settings.production
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/wazipos/waziposenv/bin/daphne \
    --bind 127.0.0.1 --port 8001 \
    --proxy-headers \
    --ping-interval 20 --ping-timeout 30 \
    --websocket_timeout 86400 \
    --application-close-timeout 10 \
    wazi.asgi:application
Restart=always
RestartSec=3
# Give in-flight sockets a moment on restart.
TimeoutStopSec=15
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
