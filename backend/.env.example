# ---- production hardening (wazi/settings/base.py)
# DEBUG (above) must be False in production; it is now read as a true/false value.
# Hosts the API answers to (comma-separated). Add any other domain / IP the server is reached by.
ALLOWED_HOSTS=api.wazipos.co.ke,wazipos.co.ke,www.wazipos.co.ke,localhost,127.0.0.1
# Websites allowed to call the API from a browser (the phone apps are unaffected).
CORS_ALLOWED_ORIGINS=https://wazipos.co.ke,https://www.wazipos.co.ke,https://app.wazipos.co.ke
CORS_ALLOW_ALL=False
# Servers default to wazi.settings.production; set this to be explicit.
DJANGO_SETTINGS_MODULE=wazi.settings.production

# ---- email (all environments)
DEFAULT_FROM_EMAIL=no-reply@wazipos.co.ke

# ---- payments (payments/utils/collection.py, collection_payouts.py)
# Every pay-in lands in WAZIPOS_JAMBOPAY_COLLECTION_ACCOUNT (above); payouts leave from it.
# Public base URL of this API (JamboPay callbacks go to <API_URL>/api/v1/payments/jambopay/callback).
API_URL=https://api.wazipos.co.ke
# Optional: a different JamboPay callback URL.
JAMBOPAY_CALLBACK_URL=
# Go-live date: pay-ins before it are never swept into payouts (YYYY-MM-DD).
PAYOUT_SWEEP_FROM=
