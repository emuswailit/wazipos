                                                        name="customer_name"
                                                        autoFocus
                                                        label="Customer Names"
                                                        placeholder="Enter customer names"
                                                        variant="bordered"
                                                        type="text"
                                                        onChange={formikAnonymousCustomer.handleChange}
                                                        onBlur={formikAnonymousCustomer.handleBlur}
                                                        defaultValue={formikAnonymousCustomer.values.customer_name}
                                                        value={formikAnonymousCustomer.values.customer_name}
                                                        color={formikAnonymousCustomer.errors.customer_name ? "danger" : "grey"}
                                                        errorMessage={formikAnonymousCustomer.errors.customer_name}
                                                    />
                                                    <Input
                                                        id="customer_phone"
                                                        name="customer_phone"
                                                        autoFocus
                                                        label="Customer phone"
                                                        placeholder="Enter customer phone e.g. 07xx xxx xxx"
                                                        variant="bordered"
                                                        type="text"
                                                        onChange={formikAnonymousCustomer.handleChange}
                                                        onBlur={formikAnonymousCustomer.handleBlur}
                                                        defaultValue={formikAnonymousCustomer.values.customer_phone}
                                                        value={formikAnonymousCustomer.values.customer_phone}
                                                        color={formikAnonymousCustomer.errors.customer_phone ? "danger" : "grey"}
                                                        errorMessage={formikAnonymousCustomer.errors.customer_phone}
                                                    />

                                                    <div className="flex gap-2 justify-end">
                                                        <Button type="submit" fullWidth color="primary">
                                                            Create Order
                                                        </Button>
                                                    </div>
                                                </form>
                                            </Tab>
                                        </Tabs>
                                    </CardBody>
                                </Card>
                            </ModalBody>
                            <ModalFooter>
                                <Button color="danger" variant="flat" onPress={() => setopenEditModal(false)}>
                                    Cancel
                                </Button>

                            </ModalFooter>



                        </>
                    )}
                </ModalContent>
            </Modal>
        </>
