class CustomerOrderItem {
  constructor(
    id,
    draft_id,
    title,
    preparation_id,
    preparation_title,
    product_id,
    product_title,
    units_per_pack,
    pack_selling_price,
    unit_selling_price,
    batch,
    retailer_receipt,
    available_quantity,
    purchased_quantity,
    discount_quantity,
    total_quantity,
    item_price,
    item_price_total,
    item_discount,
    item_discount_total,
    item_tax,
    item_tax_total,
    item_net_price,
    item_net_price_total,
    item_counter_price_discount,
    discounted_counter_selling_price,
    item_counter_price_discount_amount,
    image
  ) {
    this.id = id;
    this.draft_id = draft_id;
    this.title = title;
    this.preparation_id = preparation_id;
    this.preparation_title = preparation_title;
    this.product_id = product_id;
    this.product_title = product_title;
    this.units_per_pack = units_per_pack;
    this.pack_selling_price = pack_selling_price;
    this.unit_selling_price = unit_selling_price;
    this.batch = batch;
    this.retailer_receipt = retailer_receipt;
    this.available_quantity = available_quantity;
    this.purchased_quantity = purchased_quantity;
    this.discount_quantity = discount_quantity;
    this.total_quantity = total_quantity;
    this.item_price = item_price;
    this.item_price_total = item_price_total;
    this.item_discount = item_discount;
    this.item_discount_total = item_discount_total;
    this.item_tax = item_tax;
    this.item_tax_total = item_tax_total;
    this.item_net_price = item_net_price;
    this.item_net_price_total = item_net_price_total;
    this.item_counter_price_discount = item_counter_price_discount;
    this.discounted_counter_selling_price = discounted_counter_selling_price;
    this.item_counter_price_discount_amount = item_counter_price_discount_amount;
    this.image = image;
  }
}

export default CustomerOrderItem;
